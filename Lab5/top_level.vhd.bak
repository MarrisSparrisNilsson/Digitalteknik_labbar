library ieee;
    use ieee.std_logic_1164.all;
    use ieee.numeric_std.all;
library work;

entity top_level is
    port (
        clk_50      : in std_logic;
        reset_n     : in std_logic;
        uart_rxd    : in std_logic;
        hex0        : out std_logic_vector(6 downto 0);
        ledr        : out std_logic_vector(1 downto 0)
    );
end top_level;

architecture rtl of top_level is

begin

    serial_uart : entity work.serial_uart_rtl
    generic map(
        g_serial_speed_bps => 9600;
    )
    port map(
        clk => clk_50,
        reset => reset_n,
        rx => uart_rxd,
        transmit_data_valid => open,
        transmit_data => open
    );

    hearbeat_led : entity work.top_level_lab3
    port map(
        clock_50 => clk_50,
        key_n => open,
        ledr => ledr(0)
    );

    component display_ascii_number is
        port (
            recived_data_cmpt        : in std_logic_vector(7 downto 0);
            recived_data_valid_cmpt  : in std_logic;
            number                   : out std_logic_vector(6 downto 0);
        );
    end component display_ascii_number;

    display_ascii_number : entity work.serial_uart_rtl
    port map(
        recived_data_cmpt        => recived_data,
        recived_data_valid_cmpt  => recived_data_valid
    );

    display_ascii_number : top_level
    port map(
        number => hex0
    );


end architecture rtl;